# Copy to .dev.vars for `npx wrangler dev` (.dev.vars is gitignored; never commit real values).
# In production set these with `npx wrangler secret put <NAME>` instead.

# The secret you typed into the GitHub webhook. Not needed with --var DRY_RUN:true.
GITHUB_WEBHOOK_SECRET=

# Fine-grained token limited to one repository: Pull requests (read), Issues (read and write).
# Even for local dry runs, a token here avoids GitHub's anonymous rate limit (60 requests an hour) when fetching PR diffs.
GITHUB_TOKEN=
